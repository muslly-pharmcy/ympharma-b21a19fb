# YMPharma (ympharma-b21a19fb) — public client configuration
# Copy to .env.local and fill in. Never commit real values.
# Secrets (service role keys, AI keys, WhatsApp tokens) are managed server-side
# by Lovable Cloud and must NOT use the VITE_ prefix.

# --- Backend (public, client-safe) ---
VITE_SUPABASE_URL="https://ybhrmcdlgyccywpmiucz.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key-from-ybhrmcdlgyccywpmiucz>"
VITE_SUPABASE_PROJECT_ID="ybhrmcdlgyccywpmiucz"

# --- Server runtime public configuration (same project and public key as above) ---
# Public production identity is pinned in config/public-backend.ts; keep integration values consistent.
SUPABASE_URL="https://ybhrmcdlgyccywpmiucz.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-key-from-ybhrmcdlgyccywpmiucz>"

# --- Site ---
VITE_SITE_URL="https://muslly.com"
# HTTPS backend used by the packaged iOS/Android shell for TanStack RPC calls.
VITE_NATIVE_SERVER_ORIGIN="https://muslly.com"
VITE_APP_NAME="MUSLLY AI OS"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

# --- Feature flags ---
VITE_ENABLE_COSMIC_OS="true"
VITE_ENABLE_QUANTUM_MEMORY="true"
VITE_ENABLE_SELF_HEALING="true"
VITE_PERSISTENT_COSMIC_MODE="true"
VITE_SOVEREIGN_PROTOCOL="true"
VITE_AI_SUN_VERSION="2.1"
VITE_AI_MODEL="gpt-4o"

# --- Optional third-party public keys ---
VITE_GOOGLE_MAPS_API_KEY=""
VITE_STRIPE_PUBLIC_KEY=""
VITE_RAZORPAY_KEY=""

# --- Server-only secrets (configure in the deployment dashboard, never in VITE_ variables) ---
# Required by the Node server for private product-image signing and trusted
# administrative operations. It must belong to ybhrmcdlgyccywpmiucz.
# Leave empty in source control; configure it securely in Lovable.
SUPABASE_SERVICE_ROLE_KEY=""

# Selected external project: custom server-only bindings avoid reserved Cloud credentials.
MUSLLY_SUPABASE_PROJECT_ID="ybhrmcdlgyccywpmiucz"
MUSLLY_SUPABASE_SERVICE_ROLE_KEY=""
