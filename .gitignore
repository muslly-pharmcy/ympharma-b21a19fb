# Dev Artifacts

# Keep developer-generated artifacts out of commits
artifacts/
artifacts/**

# Generated by frozen install, Vite/Nitro, and test runners
node_modules/
.output/
.tanstack/
.nitro/
.wrangler/
dist/
coverage/
playwright-report/
test-results/

# Local environment values; keep the documented example tracked
.env
.env.*
!.env.example
